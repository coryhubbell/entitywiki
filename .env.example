# Server-only configuration. Keep actual values in secret storage, never Git.
# Default: all operator routes fail closed. Production uses verified Access JWTs.
OPERATOR_AUTH_MODE=cloudflare-access
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=
ACCESS_OPERATOR_EMAILS=
# Explicit localhost-only alternative: OPERATOR_AUTH_MODE=local plus a random key
# of at least 32 characters. Local encrypted HttpOnly sessions expire in one hour.
OPERATOR_LOCAL_KEY=
SCHEMABRAINS_API_KEY=
GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=
# The replacement has no live-wiki write credential or write-enable setting.
